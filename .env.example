# Existing Supabase, PesaPal, push, and admin configuration belongs in the
# deployment environment. These values prepare the POS hardware bridge only.
# Keep this disabled until the physical bridge tests have passed.
POS_HARDWARE_BRIDGE_ENABLED=false
POS_HARDWARE_BRIDGE_URL=http://127.0.0.1:17891

# Generate once with: npm run generate:pos-hardware-key
# Store the emitted private value as a deployment secret. Never expose it to
# the browser or commit it to this file.
POS_HARDWARE_JWK_PRIVATE_KEY_B64=
POS_HARDWARE_JWT_ISSUER=firestone-smokehouse
POS_HARDWARE_JWT_AUDIENCE=smokehouse-pos-bridge
